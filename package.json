{
	"name": "@knockdata/sqlite",
	"version": "3.51.3-r.3",
	"description": "A minimal SQLite build for browsing database files — native addon and wasm from one source",
	"type": "module",
	"main": "index.js",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/knockdata/sqlite.git"
	},
	"keywords": [
		"sqlite",
		"database",
		"wasm",
		"napi"
	],
	"exports": {
		".": "./index.js",
		"./index.js": "./index.js",
		"./browser.js": "./browser.js",
		"./engineDir.js": "./engineDir.js",
		"./wasm/sqlite.js": "./wasm/sqlite.js",
		"./wasm/sqlite.wasm": "./wasm/sqlite.wasm",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bash build.sh",
		"test": "node test/wasm.js"
	},
	"files": [
		"index.js",
		"node.js",
		"browser.js",
		"engineDir.js",
		"wasm/sqlite.js",
		"wasm/sqlite.wasm",
		"wasm/core.js",
		"wasm/vfs.js",
		"wasm/vfsFile.js",
		"wasm/worker.js",
		"README.md"
	],
	"optionalDependencies": {
		"@knockdata/sqlite-darwin-arm64": "3.51.3-r.2",
		"@knockdata/sqlite-darwin-x64": "3.51.3-r.2",
		"@knockdata/sqlite-linux-arm64": "3.51.3-r.2",
		"@knockdata/sqlite-linux-x64": "3.51.3-r.2",
		"@knockdata/sqlite-win32-arm64": "3.51.3-r.2",
		"@knockdata/sqlite-win32-x64": "3.51.3-r.2"
	},
	"engines": {
		"node": ">=20"
	}
}